{
  "byanca": true,
  "name": "easypeasyhammer",
  "version": "0.4.8",
  "description": "EasyPeasyHammer collaborative CS2 map editor",
  "main": "main.js",
  "author": "Memphis-Cat",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.memphiscat.easypeasyhammer",
    "productName": "EasyPeasyHammer",
    "asar": true,
    "electronDist": ".runtime/electron-dist",
    "files": [
      "main.js",
      "preload.js",
      "asset-host.js",
      "app-services.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/EasyPeasyHammer.AssetHost/bin/Release/net10.0/win-x64/publish",
        "to": "asset-host",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

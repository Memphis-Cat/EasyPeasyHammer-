{
  "byanca": true,
  "name": "easypeasyhammer",
  "version": "0.5.9",
  "description": "EasyPeasyHammer collaborative CS2 map editor",
  "main": "launcher.js",
  "author": "Memphis-Cat",
  "license": "UNLICENSED",
  "scripts": {
    "bundle:renderer": "node bundle-renderer.js",
    "start": "node bundle-renderer.js && electron .",
    "dev": "node bundle-renderer.js && electron .",
    "build": "node bundle-renderer.js && electron-builder --win portable",
    "build:portable": "node bundle-renderer.js && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.11",
    "esbuild": "0.25.9"
  },
  "build": {
    "appId": "com.memphiscat.easypeasyhammer",
    "productName": "EasyPeasyHammer",
    "artifactName": "EasyPeasyHammer.exe",
    "asar": false,
    "electronDist": ".runtime/electron-dist",
    "files": [
      "launcher.js",
      "main.js",
      "preload.js",
      "asset-host.js",
      "app-services.js",
      "collab-service.js",
      "collab-network.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/ws/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/EasyPeasyHammer.AssetHost/bin/Release/net10.0/win-x64/publish",
        "to": "asset-host",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": ["portable"]
    }
  }
}
